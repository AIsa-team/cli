{
  "id": "n1_natural_traffic_quote",
  "suite": "natural",
  "title": "Natural request: monthly worldwide traffic estimate",
  "goal": "我想看看 notion.so 在 2026 年 2 月到 7 月的全球访问情况，重点是访问次数和跳出率。预算最多 150 个 credits。",
  "expect": {
    "quote_status": "ready",
    "budget_credits": "150",
    "totals_within_budget": true,
    "items": [{
      "capability": "similarweb.traffic_engagement@1",
      "scope_contains": {"domain": "notion.so", "start": "2026-02", "end": "2026-07", "metrics": ["visits", "bounce_rate"]},
      "estimate_credits": "12"
    }]
  },
  "scripted_reference": [
    {"argv": ["plan", "create", "--budget-credits", "150", "--intent", "n1 natural traffic quote", "--json"], "capture": "plan_id"},
    {"argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement", "--scope", "domain=notion.so", "metrics=visits,bounce_rate", "country=world", "start=2026-02", "end=2026-07"]},
    {"argv": ["plan", "quote", "{plan}", "--json"]}
  ]
}
