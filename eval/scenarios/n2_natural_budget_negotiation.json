{
  "id": "n2_natural_budget_negotiation",
  "suite": "natural",
  "title": "Natural request: preserve a strict research budget",
  "goal": "我想了解 airtable.com 从 2025 年 9 月到 2026 年 8 月的访问次数、页面浏览量和跳出率，但我最多只能花 20 个 credits。请在预算内给我一个可执行的方案。",
  "expect": {
    "quote_status": "ready",
    "budget_credits": "20",
    "totals_within_budget": true,
    "totals_max_credits_lte": "20",
    "items": [{"capability": "similarweb.traffic_engagement@1", "scope_contains": {"domain": "airtable.com"}}]
  },
  "scripted_reference": [
    {"argv": ["plan", "create", "--budget-credits", "20", "--budget-policy", "hard", "--intent", "n2 natural budget negotiation", "--json"], "capture": "plan_id"},
    {"argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement", "--scope", "domain=airtable.com", "metrics=visits,page_views,bounce_rate", "country=world", "start=2025-09", "end=2026-08"]},
    {"argv": ["plan", "quote", "{plan}", "--json"], "expect_exit": 2},
    {"argv": ["plan", "item-replace", "{plan}", "itm_01", "--scope", "domain=airtable.com", "metrics=visits", "country=world", "start=2026-07", "end=2026-08"]},
    {"argv": ["plan", "quote", "{plan}", "--json"]}
  ]
}
