{
  "id": "n3_natural_unverified_pricing",
  "suite": "natural",
  "title": "Natural request: bounded web research with an unknown price",
  "goal": "请帮我查 Notion 的定价页面。我这件事总预算是 30 个 credits，而且单项最多愿意花 15 个 credits。",
  "expect": {
    "quote_status": "ready",
    "budget_credits": "30",
    "totals_within_budget": true,
    "items": [{
      "capability": "web_search.tavily@1",
      "scope_contains": {"query": "notion pricing"},
      "estimate_null": true,
      "max_credits_set": true,
      "max_credits_lte": "15"
    }]
  },
  "scripted_reference": [
    {"argv": ["plan", "create", "--budget-credits", "30", "--budget-policy", "hard", "--intent", "n3 natural unverified pricing", "--json"], "capture": "plan_id"},
    {"argv": ["plan", "add", "{plan}", "web_search.tavily", "--scope", "query=notion pricing page", "--max-credits", "15"]},
    {"argv": ["plan", "quote", "{plan}", "--json"]}
  ]
}
