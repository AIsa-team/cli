{
  "id": "n4_natural_capability_fit",
  "suite": "natural",
  "title": "Natural request: precise low-budget US traffic lookup",
  "goal": "帮我查一下 OpenAI 官网在美国 2026 年 7 月的访问量，只看访问次数，最多花 1 个 credit。",
  "expect": {
    "quote_status": "ready",
    "budget_credits": "1",
    "totals_within_budget": true,
    "totals_max_credits_lte": "1",
    "items_count": 1,
    "items": [{
      "capability": "similarweb.traffic_engagement@1",
      "scope_contains": {"domain": "openai.com", "country": "us", "start": "2026-07", "end": "2026-07", "metrics": ["visits"]},
      "estimate_credits": "1"
    }]
  },
  "scripted_reference": [
    {"argv": ["plan", "create", "--budget-credits", "1", "--budget-policy", "hard", "--intent", "n4 natural capability fit", "--json"], "capture": "plan_id"},
    {"argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement", "--scope", "domain=openai.com", "metrics=visits", "country=us", "start=2026-07", "end=2026-07", "granularity=monthly"]},
    {"argv": ["plan", "quote", "{plan}", "--json"]}
  ]
}
