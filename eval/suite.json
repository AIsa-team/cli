{
  "version": 1,
  "name": "aisa-plan-cli",
  "description": "Outcome-graded evaluation suite for the aisa plan CLI. Source of truth for both the task set and the grading standards.",
  "standards": {
    "grading": {
      "kind": "code_based_outcome",
      "inspect": "plan_json",
      "ignore": ["transcript", "llm_judge"],
      "required_checks": ["plan_exists", "quote_exists", "quote_fresh", "quote_authority"],
      "authority": "local_preview",
      "philosophy": "Grade the final plan file on disk. Never grade the path the agent took."
    },
    "sandbox": {
      "invoke": "aisa",
      "poison_api_key": "aisa-eval-offline-do-not-use",
      "plan_dir_env": "AISA_PLAN_DIR"
    },
    "metrics": {
      "scripted": { "trials": 1, "pass_rule": "pass_hat_k" },
      "agent": {
        "trials": 3,
        "pass_rule": {
          "regression": "pass_hat_k",
          "capability": "pass_at_k",
          "natural": "pass_at_k"
        }
      }
    },
    "suites": {
      "regression": {
        "description": "Near-100% floor. A drop means the CLI contract or harness broke.",
        "default_included": true
      },
      "capability": {
        "description": "Hill to climb for weak models. One success in k trials is a signal; all-k is the customer-facing bar.",
        "default_included": true
      },
      "natural": {
        "description": "Same hidden expect as the command-contract siblings, but the goal is a plain user request with no CLI or capability hints. Inherited from codex/aisa-plan-natural-language-eval.",
        "default_included": true
      }
    }
  },
  "scenarios": [
    {
      "id": "s1_traffic_quote",
      "suite": "regression",
      "title": "Happy path: priced traffic quote within budget",
      "goal": "Create a resource plan with a hard budget of 150 credits. Add one item that prices Similarweb traffic & engagement for the domain notion.so with the metrics visits and bounce_rate, monthly from 2026-02 to 2026-07, worldwide. Finish by producing a quote whose status is ready. Do not add any other items.",
      "expect": {
        "quote_status": "ready",
        "budget_credits": "150",
        "totals_within_budget": true,
        "items": [
          {
            "capability": "similarweb.traffic_engagement@1",
            "scope_contains": {
              "domain": "notion.so",
              "start": "2026-02",
              "end": "2026-07",
              "metrics": ["visits", "bounce_rate"]
            },
            "estimate_credits": "12"
          }
        ]
      },
      "scripted_reference": [
        { "argv": ["plan", "create", "--budget-credits", "150", "--intent", "s1 traffic quote", "--json"], "capture": "plan_id" },
        { "argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement", "--scope", "domain=notion.so", "metrics=visits,bounce_rate", "country=world", "start=2026-02", "end=2026-07"] },
        { "argv": ["plan", "quote", "{plan}", "--json"] }
      ]
    },
    {
      "id": "s2_budget_negotiation",
      "suite": "capability",
      "title": "Over-budget quote must be renegotiated by shrinking scope",
      "goal": "Create a resource plan with a hard budget of 20 credits. You want Similarweb traffic & engagement for airtable.com, ideally metrics visits, page_views and bounce_rate monthly from 2025-09 to 2026-08 — but that is over budget. If a quote comes back over budget (exit code 2), reduce the scope (fewer metrics and/or a shorter month range) and re-quote until the quote status is ready within the 20-credit budget. Keep the domain airtable.com. Finish with a ready quote.",
      "expect": {
        "quote_status": "ready",
        "budget_credits": "20",
        "totals_within_budget": true,
        "totals_max_credits_lte": "20",
        "items": [
          {
            "capability": "similarweb.traffic_engagement@1",
            "scope_contains": { "domain": "airtable.com" }
          }
        ]
      },
      "scripted_reference": [
        { "argv": ["plan", "create", "--budget-credits", "20", "--intent", "s2 budget negotiation", "--json"], "capture": "plan_id" },
        { "argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement", "--scope", "domain=airtable.com", "metrics=visits,page_views,bounce_rate", "start=2025-09", "end=2026-08"] },
        { "argv": ["plan", "quote", "{plan}"], "expect_exit": 2 },
        { "argv": ["plan", "item-replace", "{plan}", "itm_01", "--scope", "domain=airtable.com", "metrics=visits,page_views", "start=2026-01", "end=2026-05"] },
        { "argv": ["plan", "quote", "{plan}", "--json"] }
      ]
    },
    {
      "id": "s3_unverified_pricing_cap",
      "suite": "regression",
      "title": "Unverified pricing requires an explicit per-item spend cap",
      "goal": "Create a resource plan with a hard budget of 30 credits. Add one web search item for the query 'notion pricing page' using the web_search.tavily capability. Its pricing is unverified, so the CLI will refuse to quote it unless you set a per-item spend cap with --max-credits; use a cap of at most 15 credits. Finish with a quote whose status is ready.",
      "expect": {
        "quote_status": "ready",
        "budget_credits": "30",
        "totals_within_budget": true,
        "items": [
          {
            "capability": "web_search.tavily@1",
            "scope_contains": { "query": "notion pricing" },
            "estimate_null": true,
            "max_credits_set": true,
            "max_credits_lte": "15"
          }
        ]
      },
      "scripted_reference": [
        { "argv": ["plan", "create", "--budget-credits", "30", "--intent", "s3 unverified pricing", "--json"], "capture": "plan_id" },
        { "argv": ["plan", "add", "{plan}", "web_search.tavily", "--scope", "query=notion pricing page", "limit=10", "--max-credits", "15"] },
        { "argv": ["plan", "quote", "{plan}", "--json"] }
      ]
    },
    {
      "id": "s4_jordan_capability_fit",
      "suite": "regression",
      "title": "Jordan case: compile one complete canonical scope instead of blind API trial",
      "goal": "A user named Jordan asks: find out the website traffic of openai.com in the US market for the most recent complete month (July 2026). No historical range, no other countries. Create a resource plan with a hard budget of 1 credit. Discover the fitting capability first, then add exactly ONE item with a complete, fully explicit scope — domain openai.com, country us, start 2026-07, end 2026-07, granularity monthly, single metric visits. Do not guess undocumented parameters and do not add any other items. Finish with a quote whose status is ready.",
      "expect": {
        "quote_status": "ready",
        "budget_credits": "1",
        "totals_within_budget": true,
        "totals_max_credits_lte": "1",
        "items_count": 1,
        "items": [
          {
            "capability": "similarweb.traffic_engagement@1",
            "scope_contains": {
              "domain": "openai.com",
              "country": "us",
              "start": "2026-07",
              "end": "2026-07",
              "granularity": "monthly",
              "metrics": ["visits"]
            },
            "estimate_credits": "1"
          }
        ]
      },
      "scripted_reference": [
        { "argv": ["plan", "create", "--budget-credits", "1", "--budget-policy", "hard", "--intent", "Jordan: openai.com US monthly traffic", "--json"], "capture": "plan_id" },
        { "argv": ["plan", "discover", "traffic"] },
        { "argv": ["plan", "add", "{plan}", "similarweb.traffic_engagement@1", "--scope", "domain=openai.com", "country=us", "start=2026-07", "end=2026-07", "granularity=monthly", "metrics=visits"] },
        { "argv": ["plan", "check", "{plan}"] },
        { "argv": ["plan", "quote", "{plan}", "--json"] }
      ]
    },
