{
  "name": "@aisa-one/cli",
  "version": "0.3.0",
  "description": "CLI for the AIsa unified AI infrastructure platform - one API key for 80+ LLMs and 900+ endpoints across finance, search, social, and video APIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "aisa": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/run.mjs",
    "eval:list": "node eval/run.mjs --list",
    "eval:export": "node eval/run.mjs --export-summary",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "ora": "^8.0.1",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "aisa",
    "ai",
    "llm",
    "cli",
    "api",
    "gateway",
    "skills",
    "mcp",
    "openai-compatible",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIsa-team/cli.git"
  },
  "bugs": {
    "url": "https://github.com/AIsa-team/cli/issues"
  },
  "homepage": "https://aisa.one",
  "author": "AIsa Team <support@aisa.one> (https://aisa.one)"
}
